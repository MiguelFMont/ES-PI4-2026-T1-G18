# Copie este arquivo para Backend/.env e preencha. NUNCA commite o .env (valores reais, senhas e chaves).
# Obrigatórias: JWT_SECRET, MFA_JWT_SECRET, EMAIL_USER e EMAIL_PASSWORD. O Backend não sobe sem elas.

# ---------------------------------------------------------------- Servidor HTTP e autenticação
PORT=3001
JWT_SECRET=troque-por-um-segredo-forte
# Segredo do token temporário do MFA (mínimo de 32 caracteres; diferente do JWT_SECRET)
MFA_JWT_SECRET=troque-por-outro-segredo-forte-com-32-ou-mais-caracteres

# ---------------------------------------------------------------- Banco de dados (MongoDB Atlas)
# Sem MONGO_URI o Backend sobe sem banco, só para testar o caminho Backend -> Servidor Java (/v1/health e /v1/eco).
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=financeai

# ---------------------------------------------------------------- Servidor Java (sockets, só na própria máquina)
JAVA_SERVER_HOST=localhost
JAVA_SERVER_PORT=3000
JAVA_SERVER_TIMEOUT_MS=5000
JAVA_SERVER_POOL_SIZE=5

# ---------------------------------------------------------------- E-mail (recuperação de senha, via Gmail)
# EMAIL_USER é um e-mail válido; EMAIL_PASSWORD é a "senha de app" do Gmail (não a senha da conta).
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=

# ---------------------------------------------------------------- IA generativa (Mentor IA)
# Sem GENAI_API_KEY o Backend sobe, mas o Mentor IA fica indisponível.
GENAI_API_KEY=
# Valores padrão (só mude para usar outro provedor compatível com a API da OpenAI):
# GENAI_BASE_URL=https://api.groq.com/openai/v1
# GENAI_MODEL=openai/gpt-oss-120b
# GENAI_TIMEOUT_MS=20000

# ---------------------------------------------------------------- Pluggy (Open Finance, sandbox)
# Dashboard da Pluggy > Applications. O Client Secret vale como senha. Sem elas só a importação da Pluggy fica indisponível.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Valores padrão:
# PLUGGY_BASE_URL=https://api.pluggy.ai
# PLUGGY_TIMEOUT_MS=20000
# PLUGGY_ESPERA_ITEM_MS=60000
# PLUGGY_INTERVALO_MS=2000
