PORT=3001
JWT_SECRET=troque-por-um-segredo-forte
# Segredo do token temporário do MFA (mínimo de 32 caracteres; diferente do JWT_SECRET)
MFA_JWT_SECRET=troque-por-outro-segredo-forte-com-32-ou-mais-caracteres
# MongoDB Atlas (nunca commitar a URI real). Sem MONGO_URI o Backend sobe sem banco.
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=financeai
JAVA_SERVER_HOST=localhost
JAVA_SERVER_PORT=3000
JAVA_SERVER_TIMEOUT_MS=5000
JAVA_SERVER_POOL_SIZE=5
GENAI_API_KEY=
# Pluggy (sandbox): Dashboard da Pluggy > Applications. Nunca commitar os valores reais; o Client Secret vale como senha.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
